// Shared build settings for the Spotter app target.
//
// Cloud sync needs the Supabase project's URL and *publishable* key (never the secret or
// service_role key). Put them in Config/Secrets.xcconfig, which is git-ignored; copy
// Secrets.xcconfig.example. Without it the app builds and works offline.

// Version numbers, in one place for every configuration. MARKETING_VERSION follows Android's
// versionName (app/build.gradle.kts); CURRENT_PROJECT_VERSION is iOS's own build number and
// only goes up. /release bumps both.
MARKETING_VERSION = 1.1.0
CURRENT_PROJECT_VERSION = 1

// The home-screen icon: Spotter/Assets.xcassets/AppIcon, one 1024 px image rendered from
// docs/play-store/graphics/icon-ios.html (the same drawing as the Play Store icon).
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// The Kotlin framework is built for Apple silicon simulators and devices only.
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64

SUPABASE_URL =
SUPABASE_PUBLISHABLE_KEY =

#include? "Secrets.xcconfig"
