# Copy to .env.local (gitignored) and fill in the publishable key.
#
# Only PUBLISHABLE values belong in this file and in NEXT_PUBLIC_* variables: they are
# compiled into the browser bundle and are visible to anyone who opens the site. Never put
# the secret/service_role key, SMTP passwords or any other secret here or in Vercel's
# NEXT_PUBLIC_* settings; something that needs a secret goes in a Supabase Edge Function.
#
# Same values as supabase.url / supabase.publishableKey in the app's local.properties.
NEXT_PUBLIC_SUPABASE_URL=https://gaherwthntdonrsuowbh.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
